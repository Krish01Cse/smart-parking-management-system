# ====================================================================
# PARKPULSE™ — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your secret keys
# ====================================================================

# Supabase Cloud Project URL & Secret Key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-secret-key-here

# Razorpay Payment Gateway Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
